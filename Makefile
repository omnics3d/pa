# =============================================================================
# ГЛАВНЫЙ MAKEFILE
# =============================================================================

include make/black.mk
include make/isort.mk
include make/pylint.mk
include make/flake8.mk
include make/mypy.mk
include make/bandit.mk
include make/project.mk
include make/general.mk

# -----------------------------------------------------------------------------
# HELP КОМАНДЫ
# -----------------------------------------------------------------------------
.PHONY: help black-help isort-help pylint-help flake8-help mypy-help bandit-help project-help general-help

help: ## Показать категории
	@echo "================================================================"
	@echo "🚀 ZATAR PA - СИСТЕМА УПРАВЛЕНИЯ ПРОЕКТОМ"
	@echo "================================================================"
	@echo ""
	@echo "📋 КАТЕГОРИИ КОМАНД:"
	@echo ""
	@echo "  \033[1m1. BLACK - Форматирование кода:\033[0m"
	@echo "     make black-help"
	@echo ""
	@echo "  \033[1m2. ISORT - Сортировка импортов:\033[0m"
	@echo "     make isort-help"
	@echo ""
	@echo "  \033[1m3. PYLINT - Анализ качества кода:\033[0m"
	@echo "     make pylint-help"
	@echo ""
	@echo "  \033[1m4. FLAKE8 - Проверка стиля и качества:\033[0m"
	@echo "     make flake8-help"
	@echo ""
	@echo "  \033[1m5. MYPY - Проверка типов:\033[0m"
	@echo "     make mypy-help"
	@echo ""
	@echo "  \033[1m6. BANDIT - Проверка безопасности:\033[0m"
	@echo "     make bandit-help"
	@echo ""
	@echo "  \033[1m7. PROJECT - Управление проектом:\033[0m"
	@echo "     make project-help"
	@echo ""
	@echo "  \033[1m8. GENERAL - Общие утилиты:\033[0m"
	@echo "     make general-help"
	@echo ""
	@echo "================================================================"

black-help: ## Показать все команды Black
	@echo "================================================================"
	@echo "🎨 BLACK - ВСЕ КОМАНДЫ"
	@echo "================================================================"
	@echo ""
	@awk '/^[a-zA-Z_][a-zA-Z0-9_-]*:[^=]*##/ { \
		cmd = $$1; \
		sub(/:$$/, "", cmd); \
		desc = $$0; \
		sub(/.*##/, "", desc); \
		gsub(/^[ \t]+|[ \t]+$$/, "", desc); \
		printf "  \033[36m%-20s\033[0m %s\n", cmd, desc; \
	}' make/black.mk | sort
	@echo "================================================================"

isort-help: ## Показать все команды isort
	@echo "================================================================"
	@echo "📊 ISORT - ВСЕ КОМАНДЫ"
	@echo "================================================================"
	@echo ""
	@awk '/^[a-zA-Z_][a-zA-Z0-9_-]*:[^=]*##/ { \
