# =============================================================================
# ГЛАВНЫЙ MAKEFILE ДЛЯ ПРОЕКТА ZATAR PA (v2026)
# Подключает файл с определениями из папки make/
# =============================================================================

# Подключаем все .mk файлы из директории make
include make/*.mk

# -----------------------------------------------------------------------------
# КОМАНДА HELP - СБОР ВСЕХ КОМАНД ИЗ ФАЙЛОВ В make/
# -----------------------------------------------------------------------------
.PHONY: help

help: ## Показать все доступные команды из файлов в make/
	@echo "================================================================"
	@echo "ДОСТУПНЫЕ КОМАНДЫ ДЛЯ ПРОЕКТА"
	@echo "================================================================"
	@echo ""
	@grep -hE '^[a-zA-Z_-]+:.*?## .*$$' make/*.mk 2>/dev/null | \
		awk 'BEGIN {FS = ":.*?## "}; \
		{printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}' | \
		sort
	@echo ""
	@echo "Для подробной информации: make <команда>"
