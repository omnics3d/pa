project-help: ## Показать команды проекта
	@echo "📦 PROJECT КОМАНДЫ:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' make/project.mk 2>/dev/null | \
		awk 'BEGIN {FS = ":.*?## "}; \
		{printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}' | sort

general-help: ## Показать общие утилиты
	@echo "🛠️  GENERAL КОМАНДЫ:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' make/general.mk 2>/dev/null | \
		awk 'BEGIN {FS = ":.*?## "}; \
		{printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}' | sort

.DEFAULT_GOAL := help
